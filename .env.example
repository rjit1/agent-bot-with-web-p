# Gurtoy Telegram Bot Configuration
# Copy this file to .env and fill in your actual values

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=your_webhook_url  # For production
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# Razorpay Payment Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Application Configuration
APP_ENV=development  # development, staging, production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Security
SECRET_KEY=your_secret_key_for_jwt_and_encryption
ALLOWED_HOSTS=localhost,127.0.0.1

# Logging and Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn_for_error_tracking  # Optional

# Business Configuration
BUSINESS_PHONE=8300000086
BUSINESS_EMAIL=thegurtoy@gmail.com
BUSINESS_WHATSAPP=8300000086
STORE_ADDRESS="Shop No. 6/7, Char Khamba Road, Model Town, Ludhiana, Punjab, India"

# AI Model Configuration
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=1000
EMBEDDING_MODEL=models/embedding-001
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSIONALITY=1536  # Options: 768, 1536, 3072 (1536 recommended for Supabase compatibility)

# Vector Search Configuration
SIMILARITY_THRESHOLD=0.7
MAX_SEARCH_RESULTS=5
KNOWLEDGE_CACHE_TTL=3600  # seconds

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

# Session Configuration
SESSION_TIMEOUT_HOURS=24
MAX_CONVERSATION_HISTORY=50